# ──────────────────────────────────────────────────
# AI Travel Planner — Backend Environment Variables
# Copy to .env for local development.
# On EC2: set these via the launch script or AWS SSM.
# ──────────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=your_super_secret_jwt_key_here

# AWS
AWS_REGION=ap-south-1

# For LOCAL development only (on EC2, use IAM Instance Profile — no keys needed)
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key

# DynamoDB Table Names
DYNAMODB_USERS_TABLE=travelplanner-users
DYNAMODB_TRIPS_TABLE=travelplanner-trips
DYNAMODB_DOCUMENTS_TABLE=travelplanner-documents

# External APIs
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key

# Amazon Bedrock (AI Itinerary) — no API key needed, uses Lambda IAM role!
# Optional: override the default model
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
# Alternative if Claude not available in your region:
# BEDROCK_MODEL_ID=amazon.titan-text-express-v1

# Frontend URL (for CORS)
FRONTEND_URL=https://your-cloudfront-url.cloudfront.net

# Google Maps (frontend only — set in Vite .env)
# VITE_GOOGLE_MAPS_API_KEY=AIzaSyAo0Gz0je0QxyNRXTKIB6czxDXEObxaGgg
# VITE_API_URL=https://your-api-gateway-url.execute-api.ap-south-1.amazonaws.com
